# Скопируйте в .env и заполните. .env не коммитится.

# Провайдеры LLM (достаточно одного, заполняется на PHASE 5)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
MICROCHEL_LOG_LEVEL=INFO

# Путь к файлу конфигурации (по умолчанию config/config.yaml)
MICROCHEL_CONFIG=
